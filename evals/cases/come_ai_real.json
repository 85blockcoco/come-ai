      {"check": "tools_called", "tools": ["search_memory"]},
      {"check": "contains_all", "path": "answer", "values": ["VAN", "Cours synthétique de finance", "lignes 1"]},
      {"check": "budget_respected", "max": {"api_calls": 0, "network_attempts": 0}},
      {"check": "no_error"}
    ],
    "failure_conditions": ["Citation vers une source non importée, extrait absent ou résultat sans recherche réelle."]
  },
