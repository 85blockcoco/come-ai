    "expected": {"structured": {"count": 1}, "citations": [{"source_id": "SYNTHETIC-COURSE", "quote": "La VAN actualise les flux futurs. Le taux retenu dans cet exemple est de 5 %.", "line_start": 1, "line_end": 1}]},
    "acceptance": [
      {"check": "citations_valid", "min_citations": 1},
