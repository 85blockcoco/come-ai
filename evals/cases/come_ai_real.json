      {"check": "exact_value", "path": "structured.remote_model_used", "value": false},
      {"check": "budget_respected", "max": {"api_calls": 0, "generation_requests": 0, "network_attempts": 0}},
      {"check": "no_error"}
    ],
    "failure_conditions": ["Calcul absent ou faux, fournisseur invoqué, réseau tenté."]
  },
