# Copiez ce fichier vers .env, puis ajoutez la valeur de votre clé localement.
# Ne partagez jamais .env et ne le placez pas dans Git.
GEMINI_API_KEY=

# Modèle de texte avec niveau gratuit documenté. Le moteur autonome refuse
# Gemini si le projet gratuit sans facturation n'est pas confirmé ci-dessous.
GEMINI_PRIMARY_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=
COME_AI_GEMINI_FREE_PROJECT_CONFIRMED=false
OPENROUTER_API_KEY=

# Limites de résilience de l’application (pas de secret ici).
# Chaque appel est limité à 30 s et Côme AI applique en plus un budget global
# de 90 s / 8 tentatives maximum pour une demande entière.
AI_REQUEST_TIMEOUT_SECONDS=30
AI_RETRY_ATTEMPTS=3

# Facultatif — secours 100 % local si Ollama est installé sur le Mac.
# OLLAMA_MODEL=qwen3.5:2b
# OLLAMA_BASE_URL=http://127.0.0.1:11434/api/chat

# Facultatif — place la mémoire V5 sur un SSD local/externe déjà monté.
# Cette valeur est un chemin local, jamais envoyé à un modèle ni affiché dans l’interface.
# COME_AI_MEMORY_DIR=/Volumes/MonSSD/Come-AI-Memory
