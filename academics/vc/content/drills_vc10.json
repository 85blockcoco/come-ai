      "id": "VC10-D001",
      "topic_id": "VC10",
      "prompt": "Pre-money valuation: $8M. Investment: $2M. What is the post-money valuation and the investor's ownership %?",
      "variables": {
        "pre_money": 8.0,
        "investment": 2.0
      },
      "answer": {
        "post_money": 10.0,
        "ownership_pct": 20.0
      },
      "answer_unit": "percent",
      "tolerance": 0.01,
      "steps": [
        {
          "label": "Post-money formula",
          "expression": "post_money = pre_money + investment",
          "result": 10.0
        },
        {
          "label": "Ownership % formula",
          "expression": "ownership = investment / post_money * 100",
          "result": 20.0
        }
      ],
      "error_paths": [
