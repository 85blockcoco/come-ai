    {
      "kind": "drill",
      "id": "VC10-D007",
      "topic_id": "VC10",
      "prompt": "Term sheet: 1x participating liquidation preference. Company sold for $80M. Investor invested $20M. What is the total proceeds to the investor?",
      "variables": {
        "sale_price": 80.0,
        "investment": 20.0,
        "pref_type": "1x participating"
      },
      "answer": {
        "preference_amount": 20.0,
        "remaining_proceeds": 60.0,
        "investor_pro_rata": 15.0,
        "total_to_investor": 35.0
      },
      "answer_unit": "millions of dollars",
      "tolerance": 0.01,
      "difficulty": 3,
      "steps": [
        {
          "label": "Step 1: Investor takes 1x preference = their investment back",
          "expression": "20.0",
          "result": 20.0
        },
        {
          "label": "Step 2: Remaining proceeds = total - preference",
          "expression": "80 - 20 = 60",
          "result": 60.0
        },
        {
          "label": "Step 3: Investor pro-rata share of remaining = investment / post-money \u00d7 remaining",
          "expression": "20 / 80 \u00d7 60 = 15",
          "result": 15.0
        },
        {
          "label": "Step 4: Total to investor = preference + pro-rata share",
          "expression": "20 + 15 = 35",
          "result": 35.0
        }
      ]
