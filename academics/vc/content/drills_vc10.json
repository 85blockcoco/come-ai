    {
      "kind": "drill",
      "id": "VC10-D003",
      "topic_id": "VC10",
      "prompt": "Full ratchet: Original price $2/share, 1,000 shares. Down round at $1/share. What is the new conversion price and total shares after adjustment?",
      "variables": {
        "old_price": 2.0,
        "down_round_price": 1.0,
        "original_shares": 1000
      },
      "answer": {
        "new_conversion_price": 1.0,
        "total_shares_after": 2000
      },
      "answer_unit": "shares",
      "tolerance": 0.01,
      "steps": [
        {
          "label": "New conversion price",
          "expression": "new_price = down_round_price",
          "result": 1.0
        },
        {
          "label": "Total shares after adjustment",
          "expression": "original_shares * (old_price / new_price)",
          "result": 2000.0
        }
      ],
      "error_paths": [
        {
          "value": 2.0,
          "category": "formula",
          "message": "Full ratchet resets price to down-round price, not a weighted average."
        }
      ],
      "difficulty": 2
    },
    {
      "kind": "drill",
      "id": "VC10-D004",
      "topic_id": "VC10",
      "prompt": "Weighted average anti-dilution: Original price $2/share, 1,000 existing shares, new round: 500 new shares at $1/share. What is the new conversion price?",
      "variables": {
        "old_price": 2.0,
        "old_shares": 1000,
        "new_shares": 500,
        "new_price": 1.0
      },
      "answer": {
        "new_conversion_price": 1.4
      },
      "answer_unit": "ratio",
      "tolerance": 0.01,
      "steps": [
        {
          "label": "Weighted average formula numerator",
          "expression": "old_price * old_shares + new_price * new_shares",
          "result": 2500.0
        },
        {
          "label": "Weighted average formula denominator",
          "expression": "old_shares + new_shares",
          "result": 1500.0
        },
        {
          "label": "New conversion price",
          "expression": "numerator / denominator",
          "result": 1.6667
        }
      ],
      "error_paths": [
        {
          "value": 1.0,
          "category": "formula",
          "message": "This would be full ratchet, not weighted average."
        }
      ],
      "difficulty": 3
    },
