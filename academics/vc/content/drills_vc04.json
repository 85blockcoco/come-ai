      "id": "VC04-D001",
      "topic_id": "VC04",
      "prompt": "A company has a pre-money valuation of 8 M€. An investor invests 2 M€. What is the post-money valuation, in M€?",
      "variables": {"pre_money": 8, "investment": 2},
      "answer": 10,
      "answer_unit": "m_eur",
      "tolerance": 0.01,
      "steps": [
        {"label": "Formula", "expression": "post_money = pre_money + investment", "result": 10},
        {"label": "Substitution", "expression": "8 + 2", "result": 10}
