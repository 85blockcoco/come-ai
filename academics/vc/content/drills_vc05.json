    {
      "kind": "drill",
      "id": "VC05-D001",
      "topic_id": "VC05",
      "prompt": "A company has 8 million existing shares and issues 2 million new shares. What is the new shareholders' ownership, in %?",
      "variables": {"existing_shares": 8, "new_shares": 2},
      "answer": 20,
      "answer_unit": "percent",
      "tolerance": 0.01,
      "steps": [
        {"label": "Total", "expression": "8 + 2", "result": 10},
        {"label": "New share", "expression": "2 / 10", "result": 20}
      ],
      "error_paths": [
        {"value": 25, "category": "formula", "message": "You divided by the existing shares (8) instead of the total (10)."}
      ],
      "difficulty": 1
    },
    {
      "kind": "drill",
      "id": "VC05-D002",
      "topic_id": "VC05",
      "prompt": "Cap table: founders 6M shares, option pool 1M, investor 3M. What is the investor's ownership, in %?",
      "variables": {"founders": 6, "pool": 1, "investor": 3},
      "answer": 30,
      "answer_unit": "percent",
      "tolerance": 0.01,
      "steps": [
        {"label": "Fully diluted total", "expression": "6 + 1 + 3", "result": 10},
        {"label": "Investor share", "expression": "3 / 10", "result": 30}
      ],
      "error_paths": [
        {"value": 0.3, "category": "unit", "message": "The answer is correct but expressed as a ratio; a percentage is expected."}
      ],
      "difficulty": 1
    },
    {
      "kind": "drill",
      "id": "VC05-D003",
      "topic_id": "VC05",
      "prompt": "An option pool of 10% is created on a post-money valuation of 20 M€. What is its value, in M€?",
      "variables": {"pool_percent": 10, "post_money": 20},
      "answer": 2,
      "answer_unit": "m_eur",
      "tolerance": 0.01,
      "steps": [
        {"label": "Formula", "expression": "pool = pool_percent x post_money", "result": 2},
        {"label": "Substitution", "expression": "10% x 20", "result": 2}
      ],
      "error_paths": [
        {"value": 1.8, "category": "convention", "message": "The pool is computed on the post-money of 20 M€, not on a pre-money of 18 M€."}
      ],
      "difficulty": 1
    },
    {
      "kind": "drill",
      "id": "VC05-D004",
      "topic_id": "VC05",
      "prompt": "Pre-money 8 M€, investment 2 M€, option pool of 10% of post-money. What ownership do the founders keep, in %?",
