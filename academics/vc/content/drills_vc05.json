      "id": "VC05-D001",
      "topic_id": "VC05",
      "prompt": "Une société a 8 millions d'actions existantes et émet 2 millions d'actions nouvelles. Quelle est la part des nouveaux actionnaires, en % ?",
      "variables": {"existing_shares": 8, "new_shares": 2},
      "answer": 20,
      "answer_unit": "percent",
      "tolerance": 0.01,
      "steps": [
        {"label": "Total", "expression": "8 + 2", "result": 10},
        {"label": "Part nouvelle", "expression": "2 / 10", "result": 20}
      ],
      "error_paths": [
        {"value": 25, "category": "formula", "message": "Vous avez divisé par les actions existantes (8) au lieu du total (10)."}
      ],
      "difficulty": 1
    },
